# Copy to .env for docker compose.
POSTGRES_PASSWORD=change-me
GEMHUB_PUBLIC_URL=http://localhost:8080
# 0 = unlimited; otherwise least-recently-used .gem files are evicted above this size.
GEMHUB_CACHE_MAX_BYTES=0
GEMHUB_DATABASE_URL=postgresql+psycopg://gemhub:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@pg:5432/gemhub
GEMHUB_REDIS_URL=redis://:${REDIS_PASSWORD:?set REDIS_PASSWORD in .env}redis:6379/0
GEMHUB_PUBLIC_URL=${GEMHUB_PUBLIC_URL:-http://localhost:8080}
GEMHUB_CACHE_MAX_BYTES=${GEMHUB_CACHE_MAX_BYTES:-0}